{
  "dataset_class": "qlib.data.dataset.DatasetH",
  "handler_class": "qlib.data.dataset.handler.DataHandlerLP",
  "loader_class": "qlib.data.dataset.loader.StaticDataLoader",
  "features": [
    "portfolio_drawdown",
    "current_beta_cap",
    "raw_effective_beta",
    "risk_state",
    "raw_soxl_weight",
    "raw_soxx_weight",
    "raw_cash_weight",
    "tail_probability",
    "alpha_probability",
    "portfolio_ret_1d",
    "portfolio_ret_3d",
    "portfolio_ret_5d",
    "target_soxl_weight",
    "target_soxx_weight",
    "target_cash_weight",
    "pretrade_soxl_weight",
    "pretrade_soxx_weight",
    "pretrade_cash_weight",
    "soxl_weight_delta",
    "soxx_weight_delta",
    "effective_beta_delta",
    "open_turnover",
    "risk_clock",
    "days_since_trade",
    "hard_beta_cap"
  ],
  "training_state": "causal_own_policy_path",
  "evaluation_segment_reset": true,
  "training_history_reset_on_segment": false,
  "label_cost_bps": 25.0,
  "ridge_alpha": 10.0,
  "label_proxy": "one session execute-versus-hold net value plus common next own-policy desired-target reset cost; not a multiday policy rollout",
  "maturity": "label_available_at strictly before both January 1 New York of fit year and first fit-year decision",
  "recovery_branches": "separately recomputed from each branch's marked holdings; same frozen open controller snapshot",
  "maximum_training_signal_year": 2022,
  "fit_year_by_decision_year": {
    "2016": null,
    "2017": 2017,
    "2018": 2018,
    "2019": 2019,
    "2020": 2020,
    "2021": 2021,
    "2022": 2022,
    "2023": 2023,
    "2024": 2023,
    "2025": 2023,
    "2026": 2023
  }
}
