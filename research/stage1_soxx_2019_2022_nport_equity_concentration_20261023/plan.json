  "fixed_semantics": "Select only invstOrSec records where assetCat=EC, payoffProfile=Long, units=NS, curCd=USD and issuerCat=CORP. Require exactly 30 distinct original CUSIPs per report, positive balance and valUSD, and pctVal within 0.000001 percentage points of 100*valUSD/original netAssets. Exclude DE and STIV from the equity denominator but keep their counts. For each report normalize EC weights as valUSD/sum_EC_valUSD, report top-five share and sum of squared EC weights; do not substitute fund NAV percentages, current index weights or vendor current holdings.",
  "availability": "Use original SEC filing calendar date, never report-period date or XML signature date. First eligible Stage1 signal is the next actual native Qlib session strictly after the filing date; accepted-display clock is retained but timezone not certified. This source event does not assert exact intraday receipt. Retain every late-train Qlib session and keep all dates before the first 2019 NPORT public filing missing; no survivor compaction.",
  "calendar_provider": "data/qlib/minute_information_pit_allocator_20261012/daily_prices",
  "cohort": "2019-01-02 to 2022-12-30 source-calendar audit only; no SOXX outcome or model read",
  "budget": {
    "original_XML_reads_max": 13,
    "Qlib_D_calendar_calls_max": 1,
    "new_Qlib_Recorders_max": 1,
    "NAS_recorder_archives_max": 1,
    "market_outcome_reads": 0,
    "model_fits": 0,
    "native_accounts": 0,
    "DatasetH_builds_max": 1
  },
  "acceptance": "All 13 raw hashes, source identities, 30 EC rows, net-asset percentage checks and uniqueness pass; one native Qlib calendar/DatasetH alignment over every 2019-2022 session and Recorder readback pass, with pre-first-filing values missing; Recorder archive NAS SHA and scoped restore pass. This qualifies source event semantics for the late training segment, not a full 2011-2022 feature or SOXX alpha.",
  "stop": "Any raw/NAS identity drift, missing or duplicate CUSIP, nonpositive/unknown EC value, unexpected category, pctVal closure failure, filing-date collision or Qlib/Recorder/NAS mismatch stops; do not select survivor reports, renormalize missing rows or read market returns.",
